---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Developer Learning Log & Tech Showcase',
  description = 'Real developer field notes, running logs, code diffs, and architecture insights harvested across active projects.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-sky-500/30 selection:text-sky-200">
    <div class="relative flex min-h-screen flex-col">
      <Navbar />
      <main class="flex-1 mx-auto w-full max-w-6xl px-4 sm:px-6 py-8">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
