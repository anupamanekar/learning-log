---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Developer Learning Log & Tech Showcase',
  description = 'Real developer field notes, running logs, code diffs, and architecture insights harvested across active projects.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#090a0f] text-zinc-100 font-sans antialiased selection:bg-sky-500/25 selection:text-sky-200 relative overflow-x-hidden">
    <!-- Ambient radial gradient for editorial depth -->
    <div class="fixed inset-0 -z-10 pointer-events-none bg-[radial-gradient(ellipse_80%_60%_at_50%_-15%,rgba(14,165,233,0.08),rgba(255,255,255,0))]"></div>
    <div class="fixed inset-0 -z-10 pointer-events-none bg-[radial-gradient(ellipse_60%_40%_at_80%_60%,rgba(99,102,241,0.04),rgba(255,255,255,0))]"></div>

    <div class="relative flex min-h-screen flex-col">
      <Navbar />
      <main class="flex-1 mx-auto w-full max-w-6xl px-4 sm:px-6 py-8">
        <slot />
      </main>
      <Footer />
    </div>
    <Analytics />
  </body>
</html>
