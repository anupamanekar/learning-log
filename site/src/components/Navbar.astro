---
// Navbar.astro
import { getCollection } from 'astro:content';
import SearchModal from './SearchModal.astro';

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/logs', label: 'Engineering Logs' },
  { href: '/thoughts', label: 'Thoughts' },
  { href: '/diagrams', label: 'Architecture Diagrams' },
];

const entries = await getCollection('entries');
---

<header class="sticky top-0 z-40 w-full border-b border-zinc-800/80 bg-[#090a0f]/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2 font-mono font-bold text-lg text-zinc-100 hover:text-sky-400 transition-colors group">
        <span class="text-sky-400 text-xl group-hover:scale-110 transition-transform">⚡</span>
        <span>dev.journal<span class="text-sky-500 animate-pulse">_</span></span>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-400">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="hover:text-white transition-colors py-1 relative hover:after:absolute hover:after:bottom-0 hover:after:left-0 hover:after:w-full hover:after:h-[2px] hover:after:bg-sky-400 hover:after:rounded-full"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <button
        type="button"
        class="search-trigger-btn flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-3.5 py-1.5 text-xs font-medium text-zinc-400 hover:border-zinc-700 hover:text-white hover:bg-zinc-900 transition-all shadow-sm cursor-pointer"
        aria-label="Search content"
      >
        <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span class="hidden sm:inline">Search...</span>
        <kbd class="hidden sm:inline font-mono text-[10px] text-zinc-500 bg-zinc-800/80 border border-zinc-700/60 rounded px-1.5 py-0.5">⌘K</kbd>
      </button>

      <a
        href="/logs"
        class="hidden sm:inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-3.5 py-1.5 text-xs font-medium text-zinc-300 hover:border-zinc-700 hover:text-white hover:bg-zinc-900 transition-all shadow-sm"
      >
        <span>All Logs</span>
        <span class="rounded-full bg-sky-500/10 border border-sky-500/20 px-2 py-0.5 text-[10px] font-mono font-medium text-sky-400">
          {entries.length}
        </span>
      </a>
    </div>
  </div>
</header>

<SearchModal />
