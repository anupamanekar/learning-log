---
// Navbar.astro
import { getCollection } from 'astro:content';

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/blogs', label: 'Dev Logs' },
  { href: '/notes', label: 'Knowledge Vault' },
  { href: '/diagrams', label: 'Architecture Diagrams' },
];

const entries = await getCollection('entries');
---

<header class="sticky top-0 z-40 w-full border-b border-zinc-800 bg-zinc-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 font-mono font-bold text-lg text-zinc-100 hover:text-sky-400 transition-colors">
        <span class="text-sky-400">⚡</span>
        <span>dev.journal<span class="text-sky-500">_</span></span>
      </a>

      <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-zinc-400">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="hover:text-zinc-100 transition-colors py-1"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/notes"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-md border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-xs font-mono text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors"
      >
        <span>Vault Index</span>
        <span class="rounded bg-zinc-800 px-1 py-0.5 text-[10px] text-zinc-400">{entries.length} Notes</span>
      </a>
    </div>
  </div>
</header>
