---
interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<span class="inline-flex items-center rounded-full bg-[#EDE7D9] dark:bg-zinc-900/80 border border-[#DDD5C2] dark:border-zinc-800 px-2.5 py-0.5 text-[11px] font-mono text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-200 hover:border-[#C8BFA8] dark:hover:border-zinc-700 transition-colors">
  #{tag}
</span>
