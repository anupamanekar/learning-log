---
interface Props {
  project?: string;
  size?: 'sm' | 'md';
}

const { project = 'general', size = 'sm' } = Astro.props;

const styles: Record<string, { bg: string; text: string; border: string; label: string }> = {
  'market-signals-platform': {
    bg: 'bg-purple-950/40',
    text: 'text-purple-300',
    border: 'border-purple-800/60',
    label: 'market-signals',
  },
  'ai-directed-learning': {
    bg: 'bg-emerald-950/40',
    text: 'text-emerald-300',
    border: 'border-emerald-800/60',
    label: 'ai-directed-learning',
  },
  'all-projects': {
    bg: 'bg-blue-950/40',
    text: 'text-blue-300',
    border: 'border-blue-800/60',
    label: 'cross-project',
  },
};

const badge = styles[project] || {
  bg: 'bg-zinc-900',
  text: 'text-zinc-300',
  border: 'border-zinc-800',
  label: project,
};

const sizeClasses = size === 'sm' ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-1 text-xs';
---

<span class={`inline-flex items-center gap-1 font-mono font-medium rounded border ${badge.bg} ${badge.text} ${badge.border} ${sizeClasses}`}>
  <span class="inline-block w-1.5 h-1.5 rounded-full bg-current opacity-75"></span>
  {badge.label}
</span>
