---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBadge from '../../components/ProjectBadge.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('entries');
entries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categoryLabels: Record<string, string> = {
  'ai-and-agentic-engineering': 'AI & Agentic Engineering',
  'architecture-and-design': 'Architecture & Design',
  'mistakes-and-pitfalls': 'Mistakes & Pitfalls',
  'performance-and-infra': 'Performance & Infra',
  'testing-and-quality': 'Testing & Quality',
};

const formatCategory = (cat: string) => categoryLabels[cat] || cat.replace(/-/g, ' ');

// Categories list for filter buttons
const categoryKeys = Array.from(new Set(entries.map((e) => e.data.category || 'general')));
---

<BaseLayout title="Engineering Logs — dev.journal" description="Curated technical field notes, postmortems, and architectural decisions.">
  <div class="mb-10 border-b border-[#E5DEC9] dark:border-zinc-800/80 pb-8">
    <div class="flex items-center gap-2 text-xs font-mono text-sky-700 dark:text-sky-400 mb-3">
      <a href="/" class="hover:underline">Home</a>
      <span class="text-stone-400 dark:text-zinc-600">/</span>
      <span class="text-stone-600 dark:text-zinc-400">Engineering Logs</span>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
      <div>
        <h1 class="text-3xl sm:text-4xl font-display font-extrabold tracking-tight text-stone-900 dark:text-white mb-2.5">
          Engineering Logs & Field Notes
        </h1>
        <p class="text-sm sm:text-base text-stone-600 dark:text-zinc-300 max-w-3xl leading-relaxed">
          Battle-tested architectural decisions, production bugs, and code observations harvested directly from active codebases.
        </p>
      </div>
      <div class="text-xs font-mono text-stone-700 dark:text-zinc-300 bg-[#F3EFE6]/80 dark:bg-zinc-900/50 backdrop-blur border border-[#DDD5C2] dark:border-zinc-800/80 px-4 py-2 rounded-full whitespace-nowrap self-start sm:self-auto shadow-sm">
        <span>Total: </span>
        <strong class="text-stone-950 dark:text-white font-semibold">{entries.length} Curated Logs</strong>
      </div>
    </div>
  </div>

  <!-- Interactive Category Filter Bar -->
  <div class="mb-8 flex flex-wrap gap-2 text-xs" id="filter-bar">
    <button class="filter-btn active rounded-full border border-sky-600/30 dark:border-sky-500/30 bg-sky-600/15 dark:bg-sky-500/15 px-4 py-1.5 font-medium text-sky-800 dark:text-sky-300 transition-all shadow-sm cursor-pointer" data-filter="all">
      All ({entries.length})
    </button>
    {categoryKeys.map((catKey) => {
      const count = entries.filter((e) => e.data.category === catKey).length;
      return (
        <button class="filter-btn rounded-full border border-[#DDD5C2] dark:border-zinc-800 bg-[#F3EFE6]/80 dark:bg-zinc-900/50 px-4 py-1.5 font-medium text-stone-600 dark:text-zinc-400 hover:border-[#C8BFA8] dark:hover:border-zinc-700 hover:text-stone-950 dark:hover:text-white transition-all cursor-pointer" data-filter={catKey}>
          {formatCategory(catKey)} ({count})
        </button>
      );
    })}
  </div>

  <!-- Logs Grid -->
  <div class="space-y-4" id="logs-list">
    {entries.map((log) => (
      <article
        class="log-card group flex flex-col justify-between rounded-2xl border border-[#E2DAC7] dark:border-zinc-800/80 bg-[#F3EFE6]/75 dark:bg-zinc-900/40 backdrop-blur-sm p-6 hover:border-[#C8BFA8] dark:hover:border-zinc-700/80 hover:bg-[#EFE9DC] dark:hover:bg-zinc-900/70 hover:shadow-xl hover:shadow-stone-900/5 dark:hover:shadow-sky-500/5 transition-all duration-200"
        data-category={log.data.category || 'general'}
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-3.5">
          <div class="flex flex-wrap items-center gap-2">
            <ProjectBadge project={log.data.project} size="sm" />
            <span class="text-[11px] font-sans font-medium text-stone-700 dark:text-zinc-300 bg-[#EAE3D3] dark:bg-zinc-900/90 border border-[#DDD5C2] dark:border-zinc-800 rounded-full px-2.5 py-0.5">
              {formatCategory(log.data.category || 'general')}
            </span>
            {log.data.severity_or_impact && (
              <span class="text-[10px] font-mono text-amber-800 dark:text-amber-300 bg-amber-500/15 dark:bg-amber-500/10 border border-amber-600/25 dark:border-amber-500/20 px-2.5 py-0.5 rounded-full">
                Impact: {log.data.severity_or_impact}
              </span>
            )}
          </div>
          <time class="text-xs font-mono text-stone-500 dark:text-zinc-500 whitespace-nowrap">
            {new Date(log.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
        </div>

        <a href={`/logs/${log.slug}`} class="block mb-3.5">
          <h2 class="text-lg sm:text-xl font-display font-semibold text-stone-900 dark:text-zinc-100 group-hover:text-sky-700 dark:group-hover:text-sky-300 transition-colors leading-snug">
            {log.data.title}
          </h2>
        </a>

        {log.data.source_references && log.data.source_references.length > 0 && (
          <div class="mb-4 flex items-center gap-2 text-[11px] font-mono text-stone-600 dark:text-zinc-400 bg-[#EAE3D3]/80 dark:bg-zinc-950/70 border border-[#DDD5C2] dark:border-zinc-800/80 rounded-xl px-3 py-2 overflow-x-auto">
            <span class="text-sky-600 dark:text-sky-400">📄</span>
            <span class="truncate">{log.data.source_references[0]}</span>
            {log.data.source_references.length > 1 && (
              <span class="text-[10px] text-stone-500 dark:text-zinc-500 shrink-0">+{log.data.source_references.length - 1} more</span>
            )}
          </div>
        )}

        <div class="pt-3.5 border-t border-[#E2DAC7] dark:border-zinc-800/70 flex items-center justify-between">
          <div class="flex flex-wrap gap-1.5">
            {log.data.tags.slice(0, 4).map((t) => (
              <TagPill tag={t} />
            ))}
          </div>
          <a href={`/logs/${log.slug}`} class="text-xs font-mono text-sky-700 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
            <span>Read Log</span>
            <span>→</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.log-card');

  const activeClasses = ['border-sky-600/30', 'dark:border-sky-500/30', 'bg-sky-600/15', 'dark:bg-sky-500/15', 'text-sky-800', 'dark:text-sky-300', 'shadow-sm'];
  const inactiveClasses = ['border-[#DDD5C2]', 'dark:border-zinc-800', 'bg-[#F3EFE6]/80', 'dark:bg-zinc-900/50', 'text-stone-600', 'dark:text-zinc-400'];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      buttons.forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      });
      btn.classList.remove(...inactiveClasses);
      btn.classList.add(...activeClasses);

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
