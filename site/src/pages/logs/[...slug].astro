---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBadge from '../../components/ProjectBadge.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const categoryLabels: Record<string, string> = {
  'ai-and-agentic-engineering': 'AI & Agentic Engineering',
  'architecture-and-design': 'Architecture & Design',
  'mistakes-and-pitfalls': 'Mistakes & Pitfalls',
  'performance-and-infra': 'Performance & Infra',
  'testing-and-quality': 'Testing & Quality',
};

const formatCategory = (cat: string) => categoryLabels[cat] || cat.replace(/-/g, ' ');
---

<BaseLayout title={`${entry.data.title} — Engineering Log`} description={entry.data.title}>
  <div class="mb-8 border-b border-zinc-800 pb-6">
    <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-3">
      <a href="/logs" class="hover:underline">Engineering Logs</a>
      <span>/</span>
      <span class="text-zinc-500 truncate">{entry.slug}</span>
    </div>

    <div class="flex flex-wrap items-center gap-3 mb-4">
      <ProjectBadge project={entry.data.project} size="md" />
      <span class="text-xs font-mono text-zinc-300 bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">
        {formatCategory(entry.data.category || 'general')}
      </span>
      {entry.data.severity_or_impact && (
        <span class="text-xs font-mono text-amber-400/90 bg-amber-950/40 border border-amber-800/50 px-2 py-0.5 rounded">
          Impact: {entry.data.severity_or_impact}
        </span>
      )}
      <time class="text-xs font-mono text-zinc-400">
        {new Date(entry.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
      </time>
    </div>

    <h1 class="text-2xl sm:text-4xl font-bold text-white tracking-tight mb-4 leading-tight">
      {entry.data.title}
    </h1>

    {entry.data.source_references && entry.data.source_references.length > 0 && (
      <div class="rounded-lg border border-sky-900/40 bg-sky-950/20 p-3.5 mb-4">
        <div class="text-[11px] font-mono uppercase tracking-wider text-sky-400 font-semibold mb-2 flex items-center gap-1.5">
          <span>🔍</span>
          <span>Verified Source References</span>
        </div>
        <div class="flex flex-col gap-1.5">
          {entry.data.source_references.map((ref) => (
            <code class="text-xs font-mono text-sky-200 bg-sky-950/60 border border-sky-800/50 rounded px-2.5 py-1 w-fit">
              {ref}
            </code>
          ))}
        </div>
      </div>
    )}

    <div class="flex flex-wrap gap-1.5 pt-2">
      {entry.data.tags.map((t) => (
        <TagPill tag={t} />
      ))}
    </div>
  </div>

  <article class="prose prose-invert prose-zinc max-w-none prose-headings:scroll-mt-20 prose-pre:border prose-pre:border-zinc-800 prose-pre:bg-zinc-950 prose-code:font-mono prose-code:text-sky-300">
    <Content />
  </article>

  <style is:global>
    /* Suppress duplicate markdown H1 since template hero already renders title */
    .prose > h1:first-of-type {
      display: none !important;
    }
  </style>

  <div class="mt-16 pt-6 border-t border-zinc-800 flex items-center justify-between">
    <a href="/logs" class="text-xs font-mono text-sky-400 hover:text-sky-300">
      ← Back to Engineering Logs
    </a>
    <a href="#" class="text-xs font-mono text-zinc-500 hover:text-zinc-300">
      ↑ Back to Top
    </a>
  </div>
</BaseLayout>
