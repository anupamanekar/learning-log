---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mermaid from '../../components/Mermaid.astro';
import ProjectBadge from '../../components/ProjectBadge.astro';

const diagrams = [
  {
    title: 'Media Workers Decoupling & Queue Architecture',
    project: 'adaptive-edtech-platform',
    description: 'Decoupling heavy FFmpeg video stitching and Pillow canvas rendering from the FastAPI web server into standalone autoscaled container entrypoints.',
    code: `graph LR
    User["Client App"] -->|REST / POST| API["FastAPI Web Server<br/>(Lightweight, Port 8001)"]
    API -->|Write Job State| FS["Firestore<br/>(Real-time State)"]
    API -->|Publish Task| PS["Google Cloud Pub/Sub"]
    
    subgraph Isolated_Worker_Pods ["Isolated Worker Pods"]
      PS -->|Topic: audio-generation| AW["AudioWorker<br/>(TTS Synthesis)"]
      PS -->|Topic: video-composition| VW["VideoWorker<br/>(FFmpeg Subprocess)"]
    end

    AW -->|Audio Stream| GCS["Object Storage<br/>(media-bucket)"]
    VW -->|Rendered MP4| GCS
    User -.->|Listen Progress| FS
    User -->|Stream MP4| GCS`,
  },
  {
    title: 'Multi-Stage Ingestion Pipeline & Cloud GPU Offload',
    project: 'astrological-signals-engine',
    description: 'Multi-stage batch ingestion pipeline offloading heavy LLM extraction and 768-dim vector embeddings to dedicated Cloud GPU instances.',
    code: `flowchart TD
    Wiki["Source Documents & Web Records"] --> Stage1["Stage 1: Profile & Event Extraction<br/>(scripts/ingest_wikipedia.py)"]
    
    subgraph Compute_Inference ["Compute Inference"]
      Stage1 -->|HTTP POST :11434| RunPod["Cloud GPU (RTX 4090)<br/>Ollama llama3.1:8b (4 Parallel)"]
      Stage1 -.->|Burst API Fallback| Claude["Anthropic Claude Haiku API"]
    end

    RunPod --> Stage2["Stage 2: Deterministic Audit Validation<br/>(audit_ingestion.py)"]
    Stage2 -->|Zero Date Leaks| DB[("Relational Database<br/>Profile & Life Events")]
    
    DB --> Stage5["Stage 5: Vector RAG Indexing<br/>(build_rag_store.py)"]
    Stage5 -->|search_document: prefix| Nomic["nomic-embed-text (768-dim)"]
    Nomic --> VecDB[("Vector Storage<br/>HNSW Indexes")]`,
  },
  {
    title: 'Subscription Plans vs Feature Flags Schema Architecture',
    project: 'adaptive-edtech-platform',
    description: 'Relational boundary between application-level capability toggles (features) and time-bounded commercial products (plans) with cumulative expiration stacking.',
    code: `erDiagram
    USERS ||--o{ USER_PLANS : purchases
    PLANS ||--o{ USER_PLANS : links
    FEATURES ||--o{ PLANS : specifies
    
    USERS {
      int id PK
      string email
      string role
    }
    
    FEATURES {
      int id PK
      string code UK "e.g. creator_studio"
      boolean is_active
      string description
    }
    
    PLANS {
      int id PK
      string feature_code FK
      int duration_days "30 or 365"
      int price_cents
    }
    
    USER_PLANS {
      int id PK
      int user_id FK
      int plan_id FK
      datetime expires_at "Cumulative stacked expiry"
    }`,
  },
  {
    title: 'Astrological Signals Engine: Cloud Infrastructure & GPU Offload Topology',
    project: 'astrological-signals-engine',
    description: 'Production cloud deployment topology showing ingress, containerized FastAPI ASGI nodes, dedicated RunPod NVIDIA RTX 4090 GPU worker instances (running Ollama llama3.1:8b), Claude 3.5 Haiku burst fallback, and managed PostgreSQL 16 (with pgvector HNSW and GIN jsonb_path_ops).',
    code: `flowchart TB
    subgraph Client_Traffic ["Traffic & Ingestion Triggers"]
      WebClient["Web & API Clients"]
      BatchCron["Batch Ingestion Triggers<br/>(scripts/ingest_wikipedia.py)"]
    end

    subgraph Ingress_Layer ["Ingress & Gateway Tier"]
      LB["Cloud Ingress & Reverse Proxy<br/>(TLS Termination, Rate Limiting)"]
      WebClient --> LB
      BatchCron --> LB
    end

    subgraph App_Cluster ["Application Cluster (Containerized)"]
      FastAPI["FastAPI ASGI App Nodes<br/>(Port 8000, Async Endpoints)"]
      IngestWorker["Ingestion & Pipeline Engine<br/>(4 Async Worker Threads)"]
      AuditGate["Temporal Causality Audit Gate<br/>(audit_ingestion.py)"]
      LB --> FastAPI
      LB --> IngestWorker
      IngestWorker --> AuditGate
    end

    subgraph GPU_Compute_Cloud ["Cloud GPU Compute (RunPod Infrastructure)"]
      RunPodGateway["RunPod API Gateway / Router"]
      GPU1["Worker Pod 1: RTX 4090 (24GB VRAM)<br/>Ollama llama3.1:8b (:11434)"]
      GPU2["Worker Pod 2: RTX 4090 (24GB VRAM)<br/>Ollama llama3.1:8b (:11434)"]
      RunPodGateway --> GPU1
      RunPodGateway --> GPU2
    end

    subgraph External_AI_Fallback ["External Burst Fallback"]
      ClaudeAPI["Anthropic Claude 3.5 Haiku API<br/>(Dynamic Failover on RunPod Timeout)"]
    end

    subgraph Data_Storage_Cluster ["Managed Data & Storage Infrastructure"]
      PGPrimary[("PostgreSQL 16 Primary Cluster<br/>- Profiles, Transits & Aspects<br/>- GIN jsonb_path_ops Indexes<br/>- pgvector (768-dim HNSW)")]
      PGReplica[("PostgreSQL Read Replica<br/>(Sub-5ms Filter Queries)")]
      PGPrimary -.->|Streaming Replication| PGReplica
      LocalVec[("Embedded sqlite-vec<br/>(Local CI / Deterministic Tests)")]
    end

    IngestWorker -->|HTTP POST Payload| RunPodGateway
    IngestWorker -.->|Burst Fallback| ClaudeAPI
    AuditGate -->|Verified Zero-Leak Records| PGPrimary
    FastAPI -->|Fast Containment & Similarity| PGReplica
    FastAPI -->|Write Operations| PGPrimary`,
  },
  {
    title: 'Adaptive EdTech Platform: Cloud Infrastructure & Scalable Service Topology',
    project: 'adaptive-edtech-platform',
    description: 'Production cloud infrastructure spanning Cloud CDN edge distribution, lightweight FastAPI web pods on Cloud Run / GKE, Google Cloud Pub/Sub with dead-letter queue isolation, autoscaled Audio/Video worker fleet with ephemeral NVMe storage, Cloud Firestore real-time state, and Cloud Storage signed CDN delivery.',
    code: `flowchart TB
    subgraph Edge_Delivery ["Edge & CDN Delivery Tier"]
      ClientBrowser["Student & Tutor Browsers<br/>(React 18 + Vite SPA)"]
      CDN["Google Cloud CDN / Firebase Hosting<br/>(Static Chunks & Edge Media Cache)"]
      ClientBrowser -->|Load SPA Chunks| CDN
    end

    subgraph Ingress_Tier ["Ingress & API Gateway"]
      LB["Cloud Load Balancer / Ingress Gateway<br/>(TLS Termination, JWT Auth Verification)"]
      ClientBrowser -->|REST API Requests / Lesson Gen| LB
    end

    subgraph Web_App_Cluster ["Web Service Cluster (Cloud Run / GKE)"]
      WebAPI["FastAPI Web Server Pods<br/>(Lightweight ASGI, Port 8001)<br/>- Non-blocking Job Offload (&lt;40ms)<br/>- Role-Based Access Control (RBAC)"]
      LB --> WebAPI
    end

    subgraph Messaging_And_State ["Distributed State & Messaging"]
      FirestoreDB[("Google Cloud Firestore<br/>(Real-Time Job State & Lesson Progress)")]
      PubSub["Google Cloud Pub/Sub Broker"]
      TopicAudio["Topic: audio-generation<br/>(with Dead Letter Queue)"]
      TopicVideo["Topic: video-composition<br/>(with Dead Letter Queue)"]
      PubSub --> TopicAudio
      PubSub --> TopicVideo
    end

    subgraph Decoupled_Worker_Fleet ["Autoscaling Decoupled Worker Pods"]
      AudioPod["AudioWorker Pods<br/>- Sarvam AI Indian TTS Integration<br/>- In-Memory Audio Splicing"]
      VideoPod["VideoWorker Pods<br/>- Ephemeral NVMe /tmp Scratch Volumes<br/>- Subprocess Isolation & Memory Guards<br/>- Pillow Slides & FFmpeg Video Composition"]
    end

    subgraph Persistence_Storage ["Persistence & Storage Infrastructure"]
      CloudSQL[("Cloud SQL PostgreSQL<br/>- users, features, plans, user_plans<br/>- Cumulative Expiration Stacking")]
      MediaBucket[("Google Cloud Storage (GCS)<br/>media-bucket: Audio & Rendered MP4s<br/>- Signed URLs & CDN Streaming")]
    end

    WebAPI -->|Create Job Record / Listen Status| FirestoreDB
    WebAPI -->|Publish Task Event| PubSub
    WebAPI -->|Validate Entitlements| CloudSQL
    TopicAudio -->|StreamingPull| AudioPod
    TopicVideo -->|StreamingPull| VideoPod
    AudioPod -->|Update State| FirestoreDB
    VideoPod -->|Update State| FirestoreDB
    AudioPod -->|Upload Audio Stream| MediaBucket
    VideoPod -->|Upload Final Rendered MP4| MediaBucket
    MediaBucket -->|Stream Media Content| CDN
    ClientBrowser -.->|Real-time Snapshot Listener| FirestoreDB`,
  },
];
---

<BaseLayout title="Architecture Diagrams — dev.journal" description="Interactive architectural diagrams and system models.">
  <div class="mb-10 border-b border-[#E5DEC9] dark:border-zinc-800/80 pb-8">
    <div class="flex items-center gap-2 text-xs font-mono text-sky-700 dark:text-sky-400 mb-3">
      <a href="/" class="hover:underline">Home</a>
      <span class="text-stone-400 dark:text-zinc-600">/</span>
      <span class="text-stone-600 dark:text-zinc-400">Architecture Diagrams</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-display font-extrabold tracking-tight text-stone-900 dark:text-white mb-2.5">
      Architecture Diagrams & Models
    </h1>
    <p class="text-sm sm:text-base text-stone-600 dark:text-zinc-300 max-w-3xl leading-relaxed mb-4">
      Interactive system architecture diagrams, state machines, and relational models harvested from active codebases.
    </p>
    <a href="/products" class="inline-flex items-center gap-2 text-xs font-mono text-sky-700 dark:text-sky-400 hover:underline">
      <span>Looking for full product breakdowns? View Products</span>
      <span>→</span>
    </a>
  </div>

  <div class="space-y-10">
    {diagrams.map((d) => (
      <section class="rounded-2xl border border-[#E2DAC7] dark:border-zinc-800/80 bg-[#F3EFE6]/75 dark:bg-zinc-900/40 backdrop-blur-sm p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-4">
          <ProjectBadge project={d.project} size="md" />
          <span class="text-xs font-mono text-stone-600 dark:text-zinc-500 bg-[#EAE3D3] dark:bg-zinc-900/60 border border-[#DDD5C2] dark:border-zinc-800/80 rounded-full px-3 py-1">
            Interactive Model
          </span>
        </div>

        <h2 class="text-xl sm:text-2xl font-display font-bold text-stone-900 dark:text-white mb-2.5 leading-snug">{d.title}</h2>
        <p class="text-sm sm:text-base text-stone-600 dark:text-zinc-300 mb-6 leading-relaxed max-w-4xl">{d.description}</p>

        <Mermaid code={d.code} title={d.title} />
      </section>
    ))}
  </div>
</BaseLayout>
