---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBadge from '../../components/ProjectBadge.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('entries');
entries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Group by category
const categories: Record<string, typeof entries> = {};
entries.forEach((e) => {
  const cat = e.data.category || 'uncategorized';
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(e);
});
---

<BaseLayout title="Knowledge Vault Notes — dev.journal" description="Atomic engineering field notes categorized by domain.">
  <div class="mb-8 border-b border-zinc-800 pb-6">
    <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-zinc-500">Vault Notes</span>
    </div>
    <h1 class="text-3xl font-bold text-white mb-2">Engineering Knowledge Vault</h1>
    <p class="text-sm text-zinc-400">Atomic, searchable reference records covering architecture decisions, bugs, quality audits, and infra.</p>
  </div>

  <div class="space-y-12">
    {Object.entries(categories).map(([category, items]) => (
      <section>
        <div class="flex items-center gap-3 border-b border-zinc-800 pb-3 mb-4">
          <h2 class="text-lg font-mono font-bold text-sky-400 capitalize">
            {category.replace(/-/g, ' ')}
          </h2>
          <span class="rounded bg-zinc-900 border border-zinc-800 px-2 py-0.5 text-xs font-mono text-zinc-400">
            {items.length} notes
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {items.map((entry) => (
            <a
              href={`/notes/${entry.slug}`}
              class="group flex flex-col justify-between rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5 hover:border-zinc-700 hover:bg-zinc-900/80 transition-all"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-2.5">
                  <ProjectBadge project={entry.data.project} />
                  <time class="text-xs font-mono text-zinc-500">
                    {new Date(entry.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                </div>

                <h3 class="text-base font-semibold text-zinc-100 group-hover:text-sky-400 transition-colors mb-2">
                  {entry.data.title}
                </h3>
              </div>

              <div class="mt-4 pt-3 border-t border-zinc-800/60 flex items-center justify-between">
                <div class="flex flex-wrap gap-1.5">
                  {entry.data.tags.slice(0, 3).map((t) => (
                    <TagPill tag={t} />
                  ))}
                </div>
                <span class="text-xs font-mono text-zinc-500 group-hover:text-zinc-300">View Note →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
