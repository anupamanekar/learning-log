---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

const vlogs = await getCollection('vlogs');
vlogs.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Video Scripts & Vlogs — dev.journal" description="Timestamped video walk-through scripts, talk outlines, and technical demos.">
  <div class="mb-8 border-b border-zinc-800 pb-6">
    <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-zinc-500">Vlogs</span>
    </div>
    <h1 class="text-3xl font-bold text-white mb-2">Video Scripts & Vlogs</h1>
    <p class="text-sm text-zinc-400">Timestamped talk outlines, live debugging walk-throughs, and screen recording scripts.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {vlogs.map((vlog) => (
      <article class="flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 hover:border-zinc-700 transition-colors">
        <div>
          <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-3">
            <span class="text-red-400 font-semibold flex items-center gap-1.5">
              <span>🔴</span>
              <span>{vlog.data.target_medium || 'Video Script'}</span>
            </span>
            <span>⏱️ {vlog.data.estimated_duration || '5 min'}</span>
          </div>

          <h2 class="text-lg font-semibold text-white hover:text-sky-400 transition-colors mb-2">
            <a href={`/vlogs/${vlog.slug}`}>{vlog.data.title}</a>
          </h2>
        </div>

        <div class="mt-6 pt-4 border-t border-zinc-800/60 flex items-center justify-between">
          <div class="flex flex-wrap gap-1.5">
            {vlog.data.tags.map((t) => (
              <TagPill tag={t} />
            ))}
          </div>
          <a href={`/vlogs/${vlog.slug}`} class="text-xs font-mono text-sky-400 hover:text-sky-300">
            View Script →
          </a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
