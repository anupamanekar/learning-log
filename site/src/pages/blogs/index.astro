---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBadge from '../../components/ProjectBadge.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

const blogs = await getCollection('blogs');
blogs.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Developer Running Logs — dev.journal" description="Fast, code-first developer running logs with exact file:line references.">
  <div class="mb-8 border-b border-zinc-800 pb-6">
    <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-zinc-500">Blogs</span>
    </div>
    <h1 class="text-3xl font-bold text-white mb-2">Developer Running Logs</h1>
    <p class="text-sm text-zinc-400">High-signal field notes documenting bugs, fixes, benchmarks, and infrastructure setups.</p>
  </div>

  <div class="space-y-4">
    {blogs.map((post) => (
      <article class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 hover:border-zinc-700 transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-3">
            <ProjectBadge project={post.data.project} />
            <time class="text-xs font-mono text-zinc-500">
              {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
          </div>
          <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider">{post.data.status || 'Published'}</span>
        </div>

        <h2 class="text-xl font-semibold text-white mb-3 hover:text-sky-400 transition-colors">
          <a href={`/blogs/${post.slug}`}>{post.data.title}</a>
        </h2>

        {post.data.references && post.data.references.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {post.data.references.map((ref) => (
              <span class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 bg-zinc-950 border border-zinc-800/80 rounded px-2.5 py-1">
                <span class="text-sky-400">📄</span>
                <span>{ref}</span>
              </span>
            ))}
          </div>
        )}

        <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-zinc-800/60">
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((t) => (
              <TagPill tag={t} />
            ))}
          </div>
          <a href={`/blogs/${post.slug}`} class="text-xs font-mono text-sky-400 hover:text-sky-300">
            Read Full Dev Log →
          </a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
